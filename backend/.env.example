# Grace Edge backend environment
# Copy this file to backend/.env and fill in real values.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram MTProto user session
# Get API ID/hash from https://my.telegram.org, then run:
#   cd backend
#   npm run telegram:login
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_STRING_SESSION=your-generated-telegram-string-session
TELEGRAM_CHANNEL=Dead_Raisers
TELEGRAM_PUBLIC_CHANNEL_URL=https://t.me/Dead_Raisers

# Public/backend runtime
PORT=3000
PUBLIC_URL=http://localhost:3000

# Telegram indexing behavior
# auto = full backfill only when Supabase has no indexed Telegram tracks yet.
TELEGRAM_BACKFILL_ON_START=auto
TELEGRAM_BACKFILL_BATCH_SIZE=100
TELEGRAM_BACKFILL_BATCH_PAUSE_MS=850

# Audio cache
AUDIO_MEMORY_CACHE_MB=256

# Cloudflare R2 audio cache
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=graceedge-audio
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_AUDIO_PREFIX=
