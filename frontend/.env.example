# Grace Edge frontend environment
# Copy this file to frontend/.env and fill in real values.

# Supabase browser client.
# The key here must be the public/publishable Supabase key, not the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-public-or-publishable-key

# Backend API origin.
# Local combined Node server:
VITE_API_ORIGIN=http://localhost:3000

# Production example:
# VITE_API_ORIGIN=https://your-railway-backend.up.railway.app
